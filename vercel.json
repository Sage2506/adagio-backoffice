{
  "git": {
    "deploymentEnabled": {
      "develop": false
    }
  },
  "engines": {
    "node": "22.12.0"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://adagio-backend.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}